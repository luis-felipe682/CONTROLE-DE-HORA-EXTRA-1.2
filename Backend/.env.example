# Supabase Dashboard > Connect > Session pooler (recomendado para hospedagens como Render)
# Não envie este arquivo preenchido ao Git.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:5432/postgres

# Gere uma chave longa e aleatória para assinar os tokens de login.
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# URLs que podem chamar a API, separadas por vírgula.
FRONTEND_ORIGIN=http://localhost:5500,https://seu-projeto.vercel.app

# Porta usada apenas no desenvolvimento local.
PORT=3000
